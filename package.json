{
  "name": "/koris",
  "version": "0.1.4",
  "description": "Autonomous AI agent framework with pluggable channels, skills, persistent memory, and a web dashboard.",
  "main": "dist/core/src/app.js",
  "bin": {
    "/koris": "dist/core/src/app.js"
  },
  "files": [
    "dist",
    "dist-web"
  ],
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "validate": "tsx core/src/validate-settings.ts",
    "app": "node dist/core/src/app.js",
    "clean": "rm -rf dist dist-web",
    "clear:memory": "rm memory/database.*",
    "build": "pnpm run clean && tsc --project tsconfig.json && vite build",
    "build:client": "vite build",
    "dev:client": "vite",
    "lint": "tsc --noEmit -p tsconfig.json",
    "lint:client": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "release": "tsx scripts/release.ts",
    "scaffold:tool": "tsx scripts/scaffold-tool-cli.ts",
    "hub:list": "tsx scripts/hub-sync-cli.ts list",
    "hub:download": "tsx scripts/hub-sync-cli.ts download",
    "hub:pull": "tsx scripts/hub-sync-cli.ts download",
    "audio:setup": "bash scripts/audio/setup.sh small",
    "audio:setup:small": "bash scripts/audio/setup.sh small",
    "audio:setup:base": "bash scripts/audio/setup.sh base",
    "audio:setup:tiny": "bash scripts/audio/setup.sh tiny",
    "audio:setup:tts": "bash scripts/audio/setup.sh tts",
    "audio:start": "bash scripts/audio/run_audio_sidecar.sh",
    "run": "pnpm app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermesalviano/koris.git"
  },
  "keywords": [],
  "author": "guilhermesalviano",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/guilhermesalviano/koris/issues"
  },
  "homepage": "https://github.com/guilhermesalviano/koris#readme",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "ml-distance": "^5.0.0",
    "next": "^16.3.8",
    "p-limit": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/ui": "^5.0.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
